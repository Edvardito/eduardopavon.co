# Absolute path to the folder holding the artwork originals, which are never
# committed. Used only by:
#   docker compose --profile tools run --rm images
#
# Use forward slashes on every OS, including Windows (drive letter included):
#   macOS / Linux   /Users/you/Downloads/eduardopavon-images
#   Windows         C:/Users/you/Downloads/eduardopavon-images
ARTWORK_ORIGINALS=
