---
import { useTranslations, type Locale } from '~/i18n';
import { ARTIST_CONTACT } from '~/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
const headingId = 'contact-heading';
---

<section class="page mt-(--space-cycle)" aria-labelledby={headingId}>
  <h2 id={headingId} class="furniture">
    {tr('contact.heading')}
  </h2>
  <hr class="rule mt-(--space-caption)" />

  <p class="measure mt-(--space-row)">{tr('contact.intro')}</p>

  <!-- Inline line-work glyphs: no icon set, no request, no fourth colour. -->
  <ul role="list" class="contact mt-(--space-row)">
    <li>
      <a class="contact__link" href={`mailto:${ARTIST_CONTACT.email}`}>
        <svg
          class="contact__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="2.5" y="5" width="19" height="14" rx="2" />
          <path d="M3 6.6 12 13l9-6.4" />
        </svg>
        <span class="link">{tr('contact.email', { address: ARTIST_CONTACT.email })}</span>
      </a>
    </li>

    <li>
      <a
        class="contact__link"
        href={ARTIST_CONTACT.instagram.url}
        rel="me noopener"
        target="_blank"
      >
        <svg
          class="contact__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
        <span class="link">
          {tr('contact.instagram', { handle: ARTIST_CONTACT.instagram.handle })}
        </span>
      </a>
    </li>
  </ul>
</section>
