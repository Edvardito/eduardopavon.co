---
import { SLOT, splitAroundSlot, useTranslations, type Locale } from '~/i18n';
import { ARTWORK_LICENSE, SITE_AUTHOR } from '~/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);

const [before, after] = splitAroundSlot(tr('footer.license', { license: SLOT }));
const [creditBefore, creditAfter] = splitAroundSlot(tr('footer.credit', { name: SLOT }));
---

<footer class="page mt-(--space-section) pb-(--space-section)">
  <hr class="rule" />
  <h2 class="furniture mt-(--space-row)">{tr('footer.colophon')}</h2>
  <p class="measure mt-(--space-caption) text-(length:--text-caption)">{tr('footer.rights')}</p>
  <p class="measure text-(length:--text-caption)">
    {before}
    <a
      class="link"
      href={ARTWORK_LICENSE.url}
      rel="license noopener"
      target="_blank"
      aria-label={tr('footer.licenseLinkLabel', { license: ARTWORK_LICENSE.id })}
    >
      {ARTWORK_LICENSE.id}
    </a>
    {after}
  </p>
  <p class="measure mt-(--space-row) text-(length:--text-caption)">
    {creditBefore}
    <a class="link" href={SITE_AUTHOR.url} rel="noopener" target="_blank">
      {SITE_AUTHOR.name}
    </a>
    {creditAfter}
  </p>
</footer>
