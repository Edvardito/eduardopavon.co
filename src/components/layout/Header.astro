---
import Logo from '~/components/ui/Logo.astro';
import { localizePath, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="page pt-8 pb-2">
  <a href={localizePath('/', locale)} class="running-head">
    <Logo locale={locale} class="vt-masthead" />
  </a>
</header>
