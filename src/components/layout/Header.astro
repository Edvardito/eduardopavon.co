---
import { localizePath, useTranslations, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);
---

<header class="page pt-8 pb-2">
  <a href={localizePath('/', locale)} class="vt-masthead furniture inline-block">
    {tr('home.heading')}
  </a>
</header>
