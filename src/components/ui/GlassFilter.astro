---
/* Plain `filter`: the loupe has its own image layer, so it avoids the
 * Chromium-only `backdrop-filter` gap. */
---

<svg class="sr-only" aria-hidden="true" focusable="false">
  <filter id="glass-refraction" color-interpolation-filters="sRGB">
    <feImage
      href="/glass-displacement.svg"
      preserveAspectRatio="none"
      x="0"
      y="0"
      width="100%"
      height="100%"
      result="map"
    />
    <feDisplacementMap
      in="SourceGraphic"
      in2="map"
      scale="24"
      xChannelSelector="R"
      yChannelSelector="G"
    />
  </filter>
</svg>
