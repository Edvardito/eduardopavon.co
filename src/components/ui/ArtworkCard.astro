---
import type { Artwork } from '~/artworks';
import { formatDimensions, resolveLocalized, useTranslations, type Locale } from '~/i18n';
import ArtworkPlate from './ArtworkPlate.astro';

interface Props {
  artwork: Artwork;
  locale: Locale;
  priority?: boolean;
}

const { artwork, locale, priority = false } = Astro.props;
const { title, medium, dimensions, year } = artwork.data;

const tr = useTranslations(locale);
---

<figure>
  <ArtworkPlate artwork={artwork} locale={locale} priority={priority} />

  <figcaption class="caption">
    <h3 class="caption__title">{resolveLocalized(title, locale)}</h3>
    <p class="caption__line">
      {tr('artwork.catalogueLine', {
        medium: resolveLocalized(medium, locale),
        dimensions: formatDimensions(dimensions, locale),
        year,
      })}
    </p>
  </figcaption>
</figure>
