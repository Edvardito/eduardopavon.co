---
import { statusLabel, type Locale } from '~/i18n';
import type { ArtworkStatus } from '~/site';

interface Props {
  status: ArtworkStatus;
  locale: Locale;
}

const { status, locale } = Astro.props;
---

<span class:list={['status', status === 'sold' && 'status--sold']}>
  {statusLabel(status, locale)}
</span>
