---
import { artworkAltText, getSortedArtworks } from '~/artworks';
import Contact from '~/components/layout/Contact.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import ArtworkCard from '~/components/ui/ArtworkCard.astro';
import GlassFilter from '~/components/ui/GlassFilter.astro';
import Logo from '~/components/ui/Logo.astro';
import PlateIndex from '~/components/ui/PlateIndex.astro';
import Scribble from '~/components/ui/Scribble.astro';
import { SLOT, splitAroundSlot, useTranslations, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = useTranslations(locale);

const [mottoBefore, mottoAfter] = splitAroundSlot(tr('home.motto', { word: SLOT }));

const artworks = await getSortedArtworks();
const featured = artworks[0]!;

/* The title card paints first; a plate below the fold only competes. */
const EAGER_PLATES = 1;
---

<BaseLayout
  locale={locale}
  title={tr('home.title')}
  description={tr('site.description')}
  path="/"
  ogImage={featured.data.image}
  ogImageAlt={artworkAltText(featured, locale)}
  masthead={false}
>
  <JsonLd slot="head" locale={locale} path="/" artworks={artworks} />
  <GlassFilter />

  {/* Sticky is bounded by its containing block, so this lives in <main>. */}
  <div class="masthead">
    <div class="titlecard">
      <h1 id="page-heading">
        <Logo locale={locale} class="vt-masthead titlecard__logo" />
      </h1>
    </div>

    <PlateIndex artworks={artworks} locale={locale} />
  </div>

  <div class="page reveal">
    <p class="lede">
      {mottoBefore}
      <span class="scribbled">
        {tr('home.mottoWord')}
        <Scribble />
      </span>
      {mottoAfter}
    </p>
    <p class="measure statement">{tr('home.intro')}</p>
  </div>

  <section class="page mt-(--space-cycle)" aria-labelledby="gallery-heading">
    <div class="section-head">
      <h2 id="gallery-heading" class="furniture">
        {tr('gallery.heading')}
      </h2>
      <hr class="rule mt-(--space-caption)" />
    </div>

    <ul role="list" class="cadence">
      {artworks.map((artwork, index) => (
        <li id={artwork.id}>
          <ArtworkCard artwork={artwork} locale={locale} priority={index < EAGER_PLATES} />
        </li>
      ))}
    </ul>
  </section>

  <Contact locale={locale} />
</BaseLayout>

<script>
  import '~/scripts/magnifier';
</script>
