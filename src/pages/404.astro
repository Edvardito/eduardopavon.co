---
import { artworkAltText, getFeaturedArtwork } from '~/artworks';
import { getLocaleFromUrl, localizePath, useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';

const locale = getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);

const featured = await getFeaturedArtwork();
---

<BaseLayout
  locale={locale}
  title={tr('notFound.title')}
  description={tr('notFound.body')}
  path="/404"
  ogImage={featured.data.image}
  ogImageAlt={artworkAltText(featured, locale)}
>
  <section class="mx-auto w-full max-w-(--container-gallery) px-5 sm:px-8">
    <h2 class="text-2xl font-semibold tracking-tight">{tr('notFound.heading')}</h2>
    <p class="mt-3" style="color: var(--text-muted)">
      {tr('notFound.body')}
    </p>
    <p class="mt-6">
      <a class="underline underline-offset-4" href={localizePath('/', locale)}>
        {tr('notFound.back')}
      </a>
    </p>
  </section>
</BaseLayout>
