---
import { artworkAltText, getSortedArtworks } from '~/artworks';
import JsonLd from '~/components/seo/JsonLd.astro';
import ArtworkCard from '~/components/ui/ArtworkCard.astro';
import GlassFilter from '~/components/ui/GlassFilter.astro';
import PlateIndex from '~/components/ui/PlateIndex.astro';
import { getLocaleFromUrl, useTranslations } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';

const locale = getLocaleFromUrl(Astro.url);
const tr = useTranslations(locale);

const artworks = await getSortedArtworks();
const frontispiece = artworks[0]!;

/* The title card paints first; a plate below the fold only competes. */
const EAGER_PLATES = 1;
---

<BaseLayout
  locale={locale}
  title={tr('home.title')}
  description={tr('site.description')}
  path="/"
  ogImage={frontispiece.data.image}
  ogImageAlt={artworkAltText(frontispiece, locale)}
  masthead={false}
>
  <JsonLd slot="head" locale={locale} path="/" artworks={artworks} />
  <GlassFilter />

  <!-- Sticky is bounded by its containing block, so this lives in <main>. -->
  <div class="masthead">
    <div class="titlecard">
      <h1 id="page-heading" class="display vt-masthead titlecard__name">
        {tr('home.heading')}
      </h1>
    </div>

    <PlateIndex artworks={artworks} locale={locale} />
  </div>

  <p class="page lede reveal">{tr('home.intro')}</p>

  <section class="page mt-(--space-cycle)" aria-labelledby="gallery-heading">
    <div class="section-head">
      <h2 id="gallery-heading" class="furniture">
        {tr('gallery.heading')}
      </h2>
      <hr class="rule mt-(--space-caption)" />
    </div>

    <ul role="list" class="cadence">
      {artworks.map((artwork, index) => (
        <li id={artwork.id}>
          <ArtworkCard artwork={artwork} locale={locale} priority={index < EAGER_PLATES} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  import '~/scripts/magnifier';
</script>
