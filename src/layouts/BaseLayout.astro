---
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import Footer from '~/components/layout/Footer.astro';
import Header from '~/components/layout/Header.astro';
import Seo from '~/components/seo/Seo.astro';
import { LOCALE_METADATA, t, type Locale } from '~/i18n';
import '~/styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  ogImage: ImageMetadata;
  ogImageAlt: string;
  /** False where the page carries the logo as its own title card. */
  masthead?: boolean;
  /** Where the language switcher points, when it cannot be this page's own path. */
  languagePath?: string;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  masthead = true,
  languagePath = path,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={LOCALE_METADATA[locale].htmlLang}>
  <head>
    <Seo
      locale={locale}
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      noindex={noindex}
    />
    {/* No preload: the LCP is swap text or a plate, and a preload only delays it (DESIGN.md §3). */}
    <Font cssVariable="--font-polymath-super" />
    <Font cssVariable="--font-polymath" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">
      {t(locale, 'a11y.skipToContent')}
    </a>
    {masthead && <Header locale={locale} />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} path={languagePath} />
  </body>
</html>
